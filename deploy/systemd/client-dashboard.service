[Unit]
Description=Client Dashboard Uvicorn
[Service]
User=TODO_DEPLOY_USER
WorkingDirectory=/srv/client-dashboard
EnvironmentFile=/etc/client-dashboard.env
ExecStart=/srv/client-dashboard/.venv/bin/uvicorn client_dashboard.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
[Install]
WantedBy=multi-user.target
